# LLM Configuration
AZURE_OPENAI_LLM_KEY=your_azure_openai_key_here
AZURE_LLM_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_LLM_API_VERSION=2025-01-01-preview
AZURE_LLM_DEPLOYMENT_41_MINI=gpt-4.1-mini

# MongoDB
MONGO_USER=admin
MONGO_PASSWORD=your_secure_password_here
MONGO_URI=mongodb://${MONGO_USER}:${MONGO_PASSWORD}@localhost:27017
MONGO_DB=whatif

# FalkorDB
FALKOR_HOST=localhost
FALKOR_PORT=6379

# Extraction
EXTRACTION_BATCH_SIZE=10

# Chat
CHAT_HISTORY_BUDGET=6000

# Storyline
STORYLINE_COPY_THRESHOLD=500

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false

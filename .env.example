# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
LLM_API_KEY=your_api_key_here
EMBED_MODEL=text-embedding-3-small

# MongoDB
MONGO_USER=admin
MONGO_PASSWORD=your_secure_password_here
MONGO_URI=mongodb://${MONGO_USER}:${MONGO_PASSWORD}@localhost:27017
MONGO_DB=whatif

# FalkorDB
FALKOR_HOST=localhost
FALKOR_PORT=6379

# Chunking
CHUNK_TOKENS=1500
CHUNK_OVERLAP=0.1

# Chat
CHAT_HISTORY_BUDGET=6000

# Storyline
STORYLINE_COPY_THRESHOLD=500

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false

# LLM Configuration
AZURE_OPENAI_LLM_KEY=your_azure_openai_key_here
AZURE_LLM_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_LLM_API_VERSION=2025-01-01-preview
AZURE_LLM_MODEL=gpt-4.1-mini
AZURE_EMBEDDING_MODEL=
# Vector size for text-embedding-3 models (e.g. 1536); 0 keeps the full size. Re-index
# books after changing it: uv run python -m scripts.index_books
AZURE_EMBEDDING_DIMENSIONS=0

# MongoDB
MONGO_USER=your_mongo_user_here
MONGO_PASSWORD=your_secure_password_here
MONGO_URI=mongodb://${MONGO_USER}:${MONGO_PASSWORD}@localhost:27017
MONGO_DB=whatif

# FalkorDB
FALKOR_HOST=localhost
FALKOR_PORT=6379
FALKOR_PASSWORD=your_secure_password_here

# Auth: secret that signs sign-in tokens (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
AUTH_SECRET=your_random_secret_here

# Extraction
EXTRACTION_BATCH_SIZE=10
MERGE_CONCURRENCY=8

# Chat
CHAT_HISTORY_BUDGET=6000

# Agent tool server: URL of `python -m app.mcp_server streamable-http`; empty starts it over stdio per question
MCP_SERVER_URL=

# Storyline
STORYLINE_COPY_THRESHOLD=500

# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DEBUG=false

# Logging
LOG_LEVEL=INFO
# Also write logs to a rotating file (leave empty for console only), e.g. logs/whatif.log
LOG_FILE=
